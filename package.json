{
  "name": "minimi-agent",
  "version": "1.0.0",
  "description": "Conversational AI Research Agent with Hybrid Memory and Web Search",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "build": "npm --workspace=server run build && npm --workspace=client run build",
    "test": "npm --workspace=server run test",
    "test:coverage": "npm --workspace=server run test:coverage",
    "prisma:generate": "npm --workspace=server run prisma:generate",
    "prisma:migrate": "npm --workspace=server run prisma:migrate",
    "prisma:seed": "npm --workspace=server run prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
