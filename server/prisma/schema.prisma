// Prisma Schema for Minimi Research Agent

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id               String            @id @default(uuid())
  title            String            @default("New Conversation")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  messages         Message[]
  memories         Memory[]
  researchSessions ResearchSession[]

  @@index([createdAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // "user" | "assistant" | "system"
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  memories       Memory[]

  @@index([conversationId])
  @@index([createdAt])
}

model Memory {
  id             String       @id @default(uuid())
  conversationId String
  messageId      String?
  content        String
  embedding      String       // JSON-encoded array of floats (number[])
  metadata       String?      // JSON-encoded metadata (keywords, entities, dates, role, etc.)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([createdAt])
}

model ResearchSession {
  id             String             @id @default(uuid())
  conversationId String
  query          String
  status         String             @default("in_progress") // "in_progress" | "completed" | "failed"
  createdAt      DateTime           @default(now())
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  evidence       ResearchEvidence[]
  comparisons    Comparison[]

  @@index([conversationId])
  @@index([createdAt])
}

model ResearchEvidence {
  id                String          @id @default(uuid())
  researchSessionId String
  title             String
  url               String
  content           String
  publishedAt       String?
  retrievedAt       DateTime        @default(now())
  associatedClaim   String?
  isOfficial        Boolean         @default(false)
  researchSession   ResearchSession @relation(fields: [researchSessionId], references: [id], onDelete: Cascade)

  @@index([researchSessionId])
  @@index([url])
}

model Comparison {
  id                String          @id @default(uuid())
  researchSessionId String
  entity            String          // Product, service or company name
  aspect            String          // e.g. "pricing", "feature", "limits"
  historicalClaim   String
  currentClaim      String
  classification    String          // "Changed" | "Unchanged" | "New information" | "Removed" | "Unverified" | "Not comparable"
  explanation       String
  confidence        Float           @default(1.0)
  sourceUrl         String?
  researchSession   ResearchSession @relation(fields: [researchSessionId], references: [id], onDelete: Cascade)

  @@index([researchSessionId])
  @@index([entity])
  @@index([classification])
}
