# ==============================================================================
# Minimi Research Agent Configuration
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# Database Configuration (SQLite)
DATABASE_URL="file:./dev.db"

# OpenAI API Configuration
# Required for tool calling and embeddings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Tavily Web Search API Configuration
# Required for web search capabilities
TAVILY_API_KEY=your_tavily_api_key_here

# Agent Execution Limits
MAX_AGENT_ITERATIONS=5
MAX_WEB_SEARCHES_PER_REQUEST=5
AGENT_REQUEST_TIMEOUT_MS=60000

# Mock Mode (Set to true to use realistic deterministic mock services when keys are not provided)
MOCK_AI=false
